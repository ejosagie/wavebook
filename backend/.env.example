# Copy to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=data/wavebook.db
BASE_URL=http://localhost:8000
# Public domains
PUBLIC_BASE_DOMAIN=wab.ad
API_PUBLIC_URL=https://getwavebook.com
# Stripe (leave empty until ready)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_CURRENCY=gbp
# Flutterwave (card payments for bookings and subscriptions)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
FLW_CURRENCY=GBP
FLW_COUNTRY=GB
# Email relay (PHP script on the NeuroWaves hosting). Leave NOTIFY_TOKEN empty to log emails instead.
NOTIFY_URL=https://neurowavesdatasystems.ng/notification/notification.php
NOTIFY_TOKEN=
# Google Cloud Storage — public bucket for shop images, private bucket for backups.
# Leave GCS_BUCKET_NAME empty to store images on the VPS disk (backend/uploads).
GCS_BUCKET_NAME=wavebook-storefront-images
GCS_BACKUP_BUCKET=wavebook-backups
# The SMS Works (https://www.thesmsworks.co.uk) — JWT from the API Key tab
SMSWORKS_API_KEY=
SMSWORKS_SENDER_ID=WaveBook
# GoCardless (leave empty until ready)
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
# Platform admin (set strong values in production)
ADMIN_PASSWORD=change-me
ADMIN_ACCESS_TOKEN=change-me
