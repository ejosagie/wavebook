# Copy to .env and fill in real values
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=data/wavebook.db
BASE_URL=http://localhost:8000
# Public domains
PUBLIC_BASE_DOMAIN=wab.is
API_PUBLIC_URL=https://getwavebook.com
# Stripe (leave empty until ready)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_CURRENCY=gbp
# The SMS Works (https://www.thesmsworks.co.uk) — JWT from the API Key tab
SMSWORKS_API_KEY=
SMSWORKS_SENDER_ID=WaveBook
# GoCardless (leave empty until ready)
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
# Platform admin (set strong values in production)
ADMIN_PASSWORD=change-me
ADMIN_ACCESS_TOKEN=change-me
